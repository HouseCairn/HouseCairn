# HouseCairn configuration for local development.
# Copy to `.env` (never committed) or export the variables in your shell.
# Variables already set in the environment take precedence over this file.

# Development mode: verbose errors, no HTTPS enforcement, a built-in
# development secret key. Never enable in production.
DEBUG=true

# Required when DEBUG is false. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Comma-separated host names this instance answers to.
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite in HOUSECAIRN_DATA_DIR by default. PostgreSQL example:
#   DATABASE_URL=postgres://housecairn:password@db.example.com:5432/housecairn
# DATABASE_URL=

# Where the SQLite database, uploaded files and collected static files live.
# HOUSECAIRN_DATA_DIR=./data

# Sign-up with a local account (closed by default; people come in by invitation).
# Open sign-up needs outgoing email, verifies each address and asks the browser for
# a small proof of work (8 to 24 bits, 16 by default). Optional domain lists apply.
# HOUSECAIRN_SIGNUP_OPEN=false
# HOUSECAIRN_SIGNUP_POW_BITS=16
# HOUSECAIRN_SIGNUP_ALLOWED_DOMAINS=example.com
# HOUSECAIRN_SIGNUP_BLOCKED_DOMAINS=

# Public address of the instance: the links in emails use it. Set it in production.
# HOUSECAIRN_SITE_URL=https://housecairn.example.com

# Path the instance is served under, empty at the root (docs/administration/url-prefix.md).
# HOUSECAIRN_URL_PREFIX=/housecairn

# Outgoing email: invitations, address verification, password reset and security
# alerts. While EMAIL_HOST is empty, what needs a mailbox is hidden.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_TIMEOUT=15
# DEFAULT_FROM_EMAIL=HouseCairn <noreply@example.com>

# Counters of the rate limits: per process by default; share them between the web
# processes with the database.
# HOUSECAIRN_CACHE_URL=dbcache://housecairn_cache

# Generic OpenID Connect provider (disabled while OIDC_SERVER_URL is empty).
# Redirect URI to declare at the provider:
#   https://housecairn.example.com/accounts/oidc/<OIDC_PROVIDER_ID>/login/callback/
# OIDC_SERVER_URL=https://id.example.com
# OIDC_PROVIDER_ID=oidc
# OIDC_PROVIDER_NAME=Single sign-on
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# Sign-up through OIDC (docs/adr/0007). "closed" (default): an identity without
# an account is refused, except the very first sign-in of a new instance, which
# creates the instance administrator. "open": anyone the provider accepts gets
# an account, without administration rights.
# HOUSECAIRN_OIDC_SIGNUP=closed
# Until the first account exists, the first identity to sign in becomes the
# administrator. Set this to restrict that to one address the provider has
# verified, and sign in right after installing.
# HOUSECAIRN_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# The first-account screen (/setup/), opened by a one-time code written in the log while
# there is no administrator. Set to false to create the administrator another way.
# HOUSECAIRN_SETUP_SCREEN=true
