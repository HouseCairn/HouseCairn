msgstr "`ALLOWED_HOSTS`"

#, python-brace-format
msgid "`${SERVICE_FQDN_HOUSECAIRN}`: `housecairn.example.com`"
msgstr "`${SERVICE_FQDN_HOUSECAIRN}` : `housecairn.example.com`"

msgid "`CSRF_TRUSTED_ORIGINS`"
msgstr "`CSRF_TRUSTED_ORIGINS`"

#, python-brace-format
msgid "`${SERVICE_URL_HOUSECAIRN}`: `https://housecairn.example.com`"
msgstr "`${SERVICE_URL_HOUSECAIRN}` : `https://housecairn.example.com`"

msgid "`HOUSECAIRN_SITE_URL`"
msgstr "`HOUSECAIRN_SITE_URL`"

#, python-brace-format
msgid "`${SERVICE_URL_HOUSECAIRN}`: the address in emails and on printed labels"
msgstr "`${SERVICE_URL_HOUSECAIRN}` : l'adresse des e-mails et des étiquettes imprimées"

