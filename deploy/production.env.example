# Example production environment for HouseCairn.
# `manage.py check --deploy` reports no warning with these values (see
# CONTRIBUTING.md). With Docker Compose, copy it to deploy/production.env and
# adapt the host names (docs/getting-started/install.md).

DEBUG=false
# Set a key of your own and keep a copy of it apart from your backups, which
# leave it out: it encrypts the secrets stored in the database
# (docs/administration/backup.md#the-secret-key). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Left empty, the container image generates one in /data/secret_key on first
# start; keep a copy of that file apart the same way.
SECRET_KEY=
# Former keys, comma-separated, while the key is rotated
# (docs/administration/settings.md#rotate-the-key).
# SECRET_KEY_FALLBACKS=
ALLOWED_HOSTS=housecairn.example.com
CSRF_TRUSTED_ORIGINS=https://housecairn.example.com

# Set to true when a reverse proxy terminates TLS and sends X-Forwarded-Proto.
HOUSECAIRN_BEHIND_TLS_PROXY=true
# Address(es) or network(s) of that reverse proxy, comma-separated: only its
# X-Forwarded-Proto and X-Forwarded-For count (default: 127.0.0.1,::1). With
# the example compose.yaml and a proxy on the host, the container sees the
# proxy as the gateway of the Compose network, 192.0.2.1 (docs/administration/
# reverse-proxy.md). Wrong, and every request is redirected to HTTPS again.
HOUSECAIRN_FORWARDED_ALLOW_IPS=192.0.2.1

# HTTPS: redirect, secure cookies and HSTS are on by default when DEBUG is
# false. Including subdomains in HSTS, or preloading, commits the whole domain:
# enable them only if every subdomain serves HTTPS.
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# SECURE_HSTS_PRELOAD=false

HOUSECAIRN_DATA_DIR=/data
# DATABASE_URL=postgres://housecairn:password@db.example.com:5432/housecairn

# Public address of the instance, for links in emails (docs/administration/
# variables.md). Set it in production: without it, links take the Host header.
HOUSECAIRN_SITE_URL=https://housecairn.example.com

# Outgoing email: invitations, address verification, password reset and security
# alerts (docs/administration/
# variables.md). While EMAIL_HOST is empty, these features are hidden or fall
# back (an invitation link is handed to the person who invites).
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_TIMEOUT=15
# DEFAULT_FROM_EMAIL=HouseCairn <noreply@example.com>

# Single sign-on through any OpenID Connect provider (docs/adr/0007).
# OIDC_SERVER_URL=https://id.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Sign-up through OIDC stays closed; the first sign-in of a new instance
# creates the administrator. Pin it to the administrator's verified address,
# then sign in right after the first start.
# HOUSECAIRN_OIDC_SIGNUP=closed
# HOUSECAIRN_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# The first-account screen (/setup/): a one-time code is written in the log at each start
# while there is no administrator. false: create the administrator another way.
# HOUSECAIRN_SETUP_SCREEN=true

# Container image (docs/getting-started/install.md): web server processes, task worker
# processes, and the seconds given to both to stop.
# HOUSECAIRN_WEB_WORKERS=2
# HOUSECAIRN_TASK_WORKERS=2
# HOUSECAIRN_STOP_TIMEOUT=20
# Application log level; logs go to the container output.
# LOG_LEVEL=INFO

# Settings the interface can also change: a variable that is set locks its field there
# (docs/administration/settings.md). Left out, each keeps the default written here.
# TIME_ZONE=UTC
# HOUSECAIRN_DEFAULT_LANGUAGE=en
# HOUSECAIRN_INSTANCE_NAME=HouseCairn
# HOUSECAIRN_PHOTO_MAX_BYTES=10485760
# HOUSECAIRN_HOME_STORAGE_MB=5120
# HOUSECAIRN_HOME_MAX_FILES=5000
# HOUSECAIRN_INVITATION_LIFETIME_DAYS=7
# HOUSECAIRN_SIGNUP_OPEN=false
# HOUSECAIRN_SIGNUP_POW_BITS=16
# HOUSECAIRN_SIGNUP_ALLOWED_DOMAINS=
# HOUSECAIRN_SIGNUP_BLOCKED_DOMAINS=
# ACCOUNT_EMAIL_VERIFICATION=optional
# HOUSECAIRN_NOTIFICATIONS_ENABLED=false
# HOUSECAIRN_NOTIFICATIONS_INTERVAL=5
# HOUSECAIRN_NOTIFICATIONS_PRIVATE_NETWORKS=false
# HOUSECAIRN_WEBPUSH_ENABLED=false
# HOUSECAIRN_WEBPUSH_DISCREET=true
# HOUSECAIRN_LINK_PREVIEW_ENABLED=false

# Rate limits (docs/administration/rate-limits.md): the defaults, written out.
# HOUSECAIRN_RATELIMIT_LOGIN=30
# HOUSECAIRN_RATELIMIT_LOGIN_FAILURES=5
# HOUSECAIRN_RATELIMIT_SIGNUP=10
# HOUSECAIRN_RATELIMIT_SIGNUP_DAY=60
# HOUSECAIRN_RATELIMIT_PASSWORD_RESET=20
# HOUSECAIRN_RATELIMIT_INVITATIONS=10
# HOUSECAIRN_RATELIMIT_INVITATIONS_DAY=50
# HOUSECAIRN_RATELIMIT_INVITATION_LINKS=30
# HOUSECAIRN_RATELIMIT_TESTS=5
# HOUSECAIRN_RATELIMIT_LINK_PREVIEWS=10
# HOUSECAIRN_RATELIMIT_LINK_PREVIEWS_HOME=30
# Share the counters between web processes: dbcache://housecairn_cache
# HOUSECAIRN_CACHE_URL=locmemcache://housecairn

# Serving under a path prefix, and framing (docs/administration/url-prefix.md), the sentence
# of the 400 page of a refused host name, and the documentation address of the help links.
# HOUSECAIRN_URL_PREFIX=
# HOUSECAIRN_URL_PREFIX_HEADER=
# HOUSECAIRN_ALLOW_SAME_ORIGIN_FRAMING=false
# HOUSECAIRN_DISALLOWED_HOST_HINT=
# HOUSECAIRN_DOCS_URL=https://docs.housecairn.app

# A public demonstration instance, never with real data (docs/administration/demo.md).
# HOUSECAIRN_DEMO=false

# Port inside the container (the example compose.yaml publishes 8000).
# HOUSECAIRN_PORT=8000
