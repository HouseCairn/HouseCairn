# Spike only (spike/base-images/README.md): the application on Wolfi, the
# distribution of Chainguard's images. Not the production image: that one is
# the Dockerfile at the root of the repository, unchanged by this spike.
#
# The free Chainguard Python image only has the tags latest and latest-dev,
# which follow the newest Python (3.15 when this spike ran), outside the
# project's requires-python (>=3.13,<3.14). Wolfi itself still packages
# python-3.13, so this image is assembled the way apko does it: the packages
# are installed into an empty root with apk, from the free wolfi-base image,
# then copied onto `scratch`. No shell, no apk and no pip in the result; the
# apk database stays, so that scanners see every package.

FROM ghcr.io/astral-sh/uv:0.13.7@sha256:96f40d3904aad8d0bd010539001d36c8e2188b981e1334471a90c4a1d93bb490 AS uv

# --- Static files, design tokens, translations (as in production) ----------
FROM python:3.13.18-slim-trixie@sha256:09a17cad02668ae61ece136b4fd36ac3849e14f670ebedb637ea3e15580525bc AS assets
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends gettext \
    && rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_PYTHON=/usr/local/bin/python3.13 \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project
COPY LICENSE NOTICE manage.py ./
COPY design/ design/
COPY src/ src/
RUN DEBUG=true .venv/bin/python manage.py build_design_tokens \
    && DEBUG=true .venv/bin/python manage.py compilemessages --ignore=.venv \
    && DEBUG=false SECRET_KEY=build-time-only-not-a-secret HOUSECAIRN_DATA_DIR=/tmp/build-data \
        STATIC_ROOT=/app/static .venv/bin/python manage.py collectstatic --noinput \
    && .venv/bin/python -m compileall -q src

# --- Root file system: Wolfi packages only, installed by apk ----------------
FROM cgr.dev/chainguard/wolfi-base:latest@sha256:24f549a7fcace88e69b9557941168c74645688ecc4acf7fb6d734a6b74e9019d AS rootfs
# Packages are not pinned to a version in this spike: the versions installed
# are printed below and end up in the SBOM of the measurement.
# hadolint ignore=DL3018
RUN mkdir -p /rootfs/etc/apk \
    && cp -a /etc/apk/keys /etc/apk/repositories /rootfs/etc/apk/ \
    && apk add --root /rootfs --initdb --no-scripts --no-cache \
        wolfi-baselayout ca-certificates-bundle tzdata python-3.13 \
    && apk info --root /rootfs -v | sort \
    && install -d -m 0700 /empty-data

# --- Virtual environment for Wolfi's python-3.13 ----------------------------
FROM cgr.dev/chainguard/wolfi-base:latest@sha256:24f549a7fcace88e69b9557941168c74645688ecc4acf7fb6d734a6b74e9019d AS deps
# hadolint ignore=DL3018
RUN apk add --no-cache python-3.13
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_PYTHON=/usr/bin/python3.13 \
    UV_PYTHON_DOWNLOADS=never \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --extra postgres --no-install-project

# --- Final stage ------------------------------------------------------------
FROM scratch

COPY --from=rootfs /rootfs/ /
COPY --from=deps /app/.venv /app/.venv
COPY --from=assets /app/src /app/src
COPY --from=assets /app/static /app/static
COPY --from=assets /app/LICENSE /app/NOTICE /app/
COPY --from=rootfs --chown=10001:10001 /empty-data /data

ENV PATH=/app/.venv/bin:/usr/local/bin:/usr/bin:/bin \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    PYTHONPATH=/app/src \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=housecairn.settings \
    HOUSECAIRN_DATA_DIR=/data \
    STATIC_ROOT=/app/static

USER 10001:10001
WORKDIR /app
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --start-interval=2s --retries=3 \
    CMD ["python", "-m", "housecairn.entrypoint", "healthcheck"]
ENTRYPOINT ["python", "-m", "housecairn.entrypoint"]
CMD ["run"]
