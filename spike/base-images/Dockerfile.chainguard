# Spike only (spike/base-images/README.md): the application on the free
# Chainguard Python images, as Chainguard documents it (build on latest-dev,
# run on latest). Not the production image.
#
# Expected to fail at `uv sync`: the free tier only offers the tags latest and
# latest-dev, which carry the newest Python (3.15 when this spike ran), and the
# project requires Python >=3.13,<3.14. The workflow records the failure and
# then measures the bare `latest` image, so its size and vulnerabilities can
# still be compared. See Dockerfile.wolfi for Wolfi with Python 3.13.

FROM ghcr.io/astral-sh/uv:0.13.7@sha256:96f40d3904aad8d0bd010539001d36c8e2188b981e1334471a90c4a1d93bb490 AS uv

FROM cgr.dev/chainguard/python:latest-dev@sha256:898360ca56a2a65c3facdd36a4e6151133a580aa367195261554e82948921ff1 AS deps
USER root
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_PYTHON=/usr/bin/python \
    UV_PYTHON_DOWNLOADS=never \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN python --version && uv sync --locked --no-dev --extra postgres --no-install-project

FROM cgr.dev/chainguard/python:latest@sha256:1a00964779bf570a8cb2ea4fa086614af19c35069029785c08fcec0c50b66ac0
COPY --from=deps /app/.venv /app/.venv
ENTRYPOINT ["python"]
