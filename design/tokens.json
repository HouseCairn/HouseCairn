{
  "$description": "Housecairn design tokens. Single source for the web CSS variables and, later, the iOS app. Regenerate the CSS with `uv run python manage.py build_design_tokens`.",
  "color": {
    "slate": "#1F3A3D",
    "sand": "#C8A27C",
    "sage": "#8FA39A",
    "stone": "#5F726E",
    "background": "#F7F5F1",
    "surface": "#FFFFFF",
    "surface-muted": "#EEF1EF",
    "border": "#D5DCD9",
    "text": "#1C2526",
    "text-muted": "#4F605C",
    "text-inverse": "#FFFFFF",
    "primary": "#1F3A3D",
    "primary-hover": "#2B4F53",
    "accent": "#C8A27C",
    "focus": "#1F3A3D",
    "success": "#2E6B4F",
    "warning": "#7A4F00",
    "danger": "#A3322A",
    "info": "#2F5D8A"
  },
  "font": {
    "family-base": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Noto Sans\", sans-serif",
    "family-mono": "ui-monospace, \"SFMono-Regular\", Menlo, Consolas, monospace",
    "size-sm": "0.875rem",
    "size-base": "1rem",
    "size-lg": "1.25rem",
    "size-xl": "1.5rem",
    "size-2xl": "2rem",
    "weight-regular": "400",
    "weight-bold": "650",
    "line-height": "1.5"
  },
  "space": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "6": "1.5rem",
    "8": "2rem",
    "12": "3rem"
  },
  "radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "pill": "999px"
  }
}
