msgstr "Vous êtes invité avec l'adresse %(email)s."

#: src/housecairn/templates/instance/invitation.html
msgid "Create the account"
msgstr "Créer le compte"

#: src/housecairn/templates/instance/overview.html
msgid ""
"You run this instance: accounts, invitations, sign-in providers. You see no "
"home, no task and no document, and no member of a home you do not belong to."
msgstr ""
"Vous gérez cette instance : comptes, invitations, fournisseurs de connexion. "
"Vous ne voyez aucun logement, aucune tâche ni aucun document, ni aucun "
"membre d'un logement dont vous ne faites pas partie."

#: src/housecairn/templates/instance/overview.html
msgid "on"
msgstr "activée"

#: src/housecairn/templates/instance/overview.html
msgid "off"
msgstr "désactivée"

#: src/housecairn/templates/instance/overview.html
