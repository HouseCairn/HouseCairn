#: rooms/apps.py templates/rooms/choose_home.html
#: templates/rooms/room_detail.html templates/rooms/room_form.html
#: templates/rooms/room_list.html templates/rooms/search.html
#: templates/shell/navigation.html
msgid "Rooms"
msgstr "Pièces"

#: rooms/forms.py
msgid ""
"Sets the icon and the filters of the room and, later, the task templates "
"offered for it. Choose Other if none fits."
msgstr ""
"Détermine l'icône et les filtres de la pièce et, plus tard, les modèles de "
"tâches proposés pour elle. Choisissez Autre si aucun ne convient."

#: rooms/forms.py
msgid "Fills in by itself from the type; change it to name the room."
msgstr ""
"Se remplit tout seul d'après le type ; modifiez-le pour nommer la pièce."

#: rooms/forms.py
msgid "Choose a type"
msgstr "Choisissez un type"

#: rooms/forms.py
msgid "Give the room a name."
msgstr "Donnez un nom à la pièce."

#: rooms/forms.py
msgid "The colour as you would ask for it. Example: warm white."
msgstr "La couleur comme vous la demanderiez. Exemple : blanc chaud."

#: rooms/forms.py
msgid "The make of the paint. Example: Acme Paints."
msgstr "La marque de la peinture. Exemple : Peintures Acme."

#: rooms/forms.py
msgid ""
"The reference or the colour code on the tin, to order the same one. Example: "
"AC-1042."
msgstr ""
"La référence ou le code couleur inscrit sur le pot, pour recommander la "
"même. Exemple : AC-1042."

#: rooms/forms.py
msgid ""
"The batch number printed on the tin; shades can differ from one batch to "
"another. Example: L23-0457."
msgstr ""
"Le numéro de lot imprimé sur le pot ; les teintes peuvent différer d'un lot "
"à l'autre. Exemple : L23-0457."

#: rooms/forms.py
msgid "What is left of it and where. Example: half a tin, in the garage."
msgstr "Ce qu'il en reste et où. Exemple : un demi-pot, dans le garage."

#: rooms/forms.py
msgid ""
"What covers the floor, with its make and reference if you know them. "
"Example: oak parquet, matt varnish."
msgstr ""
"Ce qui recouvre le sol, avec sa marque et sa référence si vous les "
"connaissez. Exemple : parquet en chêne, vernis mat."

#: rooms/forms.py
msgid ""
"What covers the walls, under the paint if any. Example: lining paper, then "
"paint."
msgstr ""
"Ce qui recouvre les murs, sous la peinture le cas échéant. Exemple : papier "
"de doublage, puis peinture."

#: rooms/forms.py
msgid ""
"What the walls and floor hide, or anything else to remember about the work "
"done. Example: water pipe along the north wall, 30 cm above the floor."
msgstr ""
"Ce que cachent les murs et le sol, ou tout autre souvenir des travaux faits. "
"Exemple : canalisation d'eau le long du mur nord, à 30 cm du sol."

#: rooms/forms.py tasks/forms.py tasks/models.py templates/tasks/history.html
#: templates/tasks/task_list.html
msgid "Room"
msgstr "Pièce"

#: rooms/forms.py
msgid "Where the item is. Choose another room to move it."
msgstr "Où se trouve l'élément. Choisissez une autre pièce pour le déplacer."

#: rooms/forms.py templates/rooms/item_detail.html
msgid "Links"
msgstr "Liens"

#: rooms/forms.py
msgid "One per line: the address, then a label if you like."
msgstr "Un par ligne : l'adresse, puis une étiquette si vous le souhaitez."

#: rooms/forms.py
msgid "Photo"
msgstr "Photo"

#: rooms/forms.py
msgid "Caption"
msgstr "Légende"

#: rooms/forms.py
msgid "Category"
msgstr "Catégorie"

#: rooms/forms.py
msgid ""
"Behind the walls: pipes and cables photographed before the wall is closed, "
"to know where not to drill. Other: say what it is in the caption."
msgstr ""
"Derrière les murs : tuyaux et câbles photographiés avant la fermeture du "
"mur, pour savoir où ne pas percer. Autre : précisez de quoi il s'agit dans "
"la légende."

#: rooms/images.py
msgid "This file is not a valid JPEG, PNG or WebP image."
msgstr "Ce fichier n'est pas une image JPEG, PNG ou WebP valide."

#: rooms/images.py
msgid "This image is too large (more than 40 megapixels)."
msgstr "Cette image est trop grande (plus de 40 mégapixels)."

#: rooms/models.py
msgid "Links must be a list."
msgstr "Les liens doivent former une liste."

#: rooms/models.py
#, python-format
msgid "At most %(max)d links."
msgstr "%(max)d liens au plus."

#: rooms/models.py
msgid "Each link has a url and, optionally, a label."
msgstr "Chaque lien a une adresse et, facultativement, une étiquette."

#: rooms/models.py
msgid "A link or its label is too long."
msgstr "Un lien ou son étiquette est trop long."

