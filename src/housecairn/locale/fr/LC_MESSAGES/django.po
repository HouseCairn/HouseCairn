msgid "This home's sign-in provider is still offered by this instance."
msgstr ""
"Le fournisseur de connexion de ce logement est toujours proposé par cette "
"instance."

#: src/housecairn/homes/services.py
msgid "Type the exact name of the home to delete it."
msgstr "Saisissez le nom exact du logement pour le supprimer."

#: src/housecairn/homes/services.py src/housecairn/templates/homes/member.html
