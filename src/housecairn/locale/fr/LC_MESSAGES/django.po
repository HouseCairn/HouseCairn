msgstr ""
"Affiché sur la page de connexion. Testez l'émetteur avant de l'activer."

#: src/housecairn/instance/models.py
msgid "instance invitation"
msgstr "invitation à l'instance"

#: src/housecairn/instance/models.py
msgid "instance invitations"
msgstr "invitations à l'instance"

#: src/housecairn/instance/models.py
msgid "identifier"
msgstr "identifiant"

