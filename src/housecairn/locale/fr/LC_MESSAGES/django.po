msgstr "Le logement a été supprimé."

#: src/housecairn/homes/views.py src/housecairn/instance/views.py
msgid "Too many invitations in a short time. Try again later."
msgstr "Trop d'invitations en peu de temps. Réessayez plus tard."

#: src/housecairn/homes/views.py src/housecairn/instance/views.py
msgid "Invitation sent."
msgstr "Invitation envoyée."

#: src/housecairn/homes/views.py
msgid "Invitation created: share its link."
msgstr "Invitation créée : partagez son lien."

#: src/housecairn/homes/views.py src/housecairn/instance/views.py
msgid "Invitation sent again."
msgstr "Invitation renvoyée."

#: src/housecairn/homes/views.py
msgid "New link created: share it."
msgstr "Nouveau lien créé : partagez-le."

#: src/housecairn/homes/views.py src/housecairn/instance/views.py
msgid "Invitation revoked."
msgstr "Invitation révoquée."

#: src/housecairn/homes/views.py
msgid "Choose a role."
msgstr "Choisissez un rôle."

#: src/housecairn/homes/views.py
msgid "Role changed."
msgstr "Rôle modifié."

#: src/housecairn/homes/views.py
msgid "Leave this home?"
msgstr "Quitter ce logement ?"

#: src/housecairn/homes/views.py
msgid "Remove this member?"
msgstr "Retirer ce membre ?"

#: src/housecairn/homes/views.py
#, python-format
msgid ""
"You will lose access to %(home)s. Someone has to invite you again to return."
msgstr ""
"Vous perdrez l'accès à %(home)s. Il faudra qu'on vous invite à nouveau pour "
"y revenir."

#: src/housecairn/homes/views.py
#, python-format
msgid "%(who)s will lose access to %(home)s."
msgstr "%(who)s perdra l'accès à %(home)s."

#: src/housecairn/homes/views.py
msgid "Leave"
msgstr "Quitter"

#: src/housecairn/homes/views.py
msgid "Remove"
msgstr "Retirer"

#: src/housecairn/homes/views.py
#, python-format
msgid "You left %(home)s."
msgstr "Vous avez quitté %(home)s."

#: src/housecairn/homes/views.py
msgid "Member removed."
msgstr "Membre retiré."

#: src/housecairn/homes/views.py
msgid "Sign-in requirement removed."
msgstr "Exigence de connexion retirée."

#: src/housecairn/homes/views.py
msgid "Ownership transferred. You are now a member."
msgstr "Propriété transférée. Vous êtes désormais membre."

#: src/housecairn/homes/views.py
msgid "Choose a sign-in provider."
msgstr "Choisissez un fournisseur de connexion."

#: src/housecairn/homes/views.py
msgid "Sign-in requirement saved."
msgstr "Exigence de connexion enregistrée."

#: src/housecairn/homes/views.py
#, python-format
msgid "Welcome to %(home)s."
msgstr "Bienvenue dans %(home)s."

#: src/housecairn/homes/views.py
#, python-format
msgid "You joined %(home)s."
msgstr "Vous avez rejoint %(home)s."

#: src/housecairn/instance/forms.py
#: src/housecairn/templates/instance/provider.html
#: src/housecairn/templates/instance/providers.html
msgid "Identifier"
msgstr "Identifiant"

#: src/housecairn/instance/forms.py
msgid ""
"In the redirect URI; lowercase letters, digits and hyphens. It never changes "
"and is never given to another provider."
msgstr ""
"Dans l'URI de redirection ; lettres minuscules, chiffres et tirets. Il ne "
"change jamais et n'est jamais donné à un autre fournisseur."

#: src/housecairn/instance/forms.py src/housecairn/notifications/forms.py
msgid "Name"
msgstr "Nom"

#: src/housecairn/instance/forms.py
msgid "On the button, such as Company SSO."
msgstr "Sur le bouton, par exemple Company SSO."

#: src/housecairn/instance/forms.py
#: src/housecairn/templates/instance/providers.html
msgid "Issuer"
msgstr "Émetteur"

#: src/housecairn/instance/forms.py
msgid "https:// address; its OpenID configuration is read below it."
msgstr "Adresse https:// ; sa configuration OpenID est lue en dessous."

#: src/housecairn/instance/forms.py
#: src/housecairn/templates/instance/providers.html
msgid "Client identifier"
msgstr "Identifiant client"

#: src/housecairn/instance/forms.py
#: src/housecairn/templates/instance/provider.html
#: src/housecairn/templates/instance/providers.html
msgid "Client secret"
msgstr "Secret client"

#: src/housecairn/instance/forms.py
msgid ""
"Write only: it is never shown again. Empty: unchanged, but a new issuer "
"clears it."
msgstr ""
"Écriture seule : il n'est plus jamais affiché. Vide : inchangé, mais un "
"nouvel émetteur l'efface."

#: src/housecairn/instance/forms.py src/housecairn/instance/models.py
msgid "PKCE"
msgstr "PKCE"

#: src/housecairn/instance/forms.py
