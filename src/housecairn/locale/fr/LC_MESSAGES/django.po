msgstr ""
"Une invitation à cette adresse est déjà en attente : renvoyez-la plutôt."

#: src/housecairn/homes/services.py src/housecairn/instance/services.py
msgid "This invitation was already accepted or revoked."
msgstr "Cette invitation a déjà été acceptée ou révoquée."

#: src/housecairn/homes/services.py src/housecairn/instance/services.py
msgid "This invitation is for another email address."
msgstr "Cette invitation est destinée à une autre adresse e-mail."

#: src/housecairn/homes/services.py
msgid "This link was not sent by email: it cannot create an account."
msgstr ""
"Ce lien n'a pas été envoyé par e-mail : il ne peut pas créer de compte."

#: src/housecairn/homes/services.py
msgid "An account already uses this address: sign in to accept."
msgstr "Un compte utilise déjà cette adresse : connectez-vous pour accepter."

#: src/housecairn/homes/views.py
msgid "Home saved."
msgstr "Logement enregistré."

#: src/housecairn/homes/views.py
