msgid "Bad request"
msgstr "Requête invalide"

msgid "The request could not be understood."
msgstr "La requête n'a pas pu être comprise."

msgid "Back to the home page"
msgstr "Retour à l'accueil"

msgid "Access denied"
msgstr "Accès refusé"

msgid "You do not have permission to see this page."
msgstr "Vous n'avez pas le droit de voir cette page."

msgid "Session expired"
msgstr "Session expirée"

msgid "The form you sent is no longer valid, usually because the page stayed open too long. Go back, reload the page and try again."
msgstr "Le formulaire envoyé n'est plus valide, en général parce que la page est restée ouverte trop longtemps. Revenez en arrière, rechargez la page et réessayez."

msgid "Page not found"
msgstr "Page introuvable"

msgid "This page does not exist, or it has moved."
msgstr "Cette page n'existe pas ou a été déplacée."

msgid "Too many requests"
msgstr "Trop de requêtes"

msgid "Wait a minute, then try again."
msgstr "Attendez une minute, puis réessayez."

msgid "Something went wrong"
msgstr "Une erreur est survenue"

msgid "The server could not complete your request. Try again in a moment; if it keeps happening, tell the administrator of this instance."
msgstr "Le serveur n'a pas pu traiter votre demande. Réessayez dans un instant ; si cela continue, prévenez l'administrateur de cette instance."

#, python-format
msgid "Hello from %(name)s!"
msgstr "Bonjour de la part de %(name)s !"

#, python-format
msgid "Thank you for using %(name)s."
msgstr "Merci d'utiliser %(name)s."

msgid "Your account was just signed in from a browser or device we had not seen before."
msgstr "Votre compte vient d'être utilisé pour se connecter depuis un navigateur ou un appareil que nous n'avions pas encore vu."

msgid "New sign-in to your account"
msgstr "Nouvelle connexion à votre compte"

msgid "Sign in"
msgstr "Se connecter"

msgid "Send me a sign-in code"
msgstr "Envoyez-moi un code de connexion"

msgid "No account yet?"
msgstr "Pas encore de compte ?"

msgid "Create an account"
msgstr "Créer un compte"

msgid "Already have an account?"
msgstr "Vous avez déjà un compte ?"

msgid "Checking that you are not a robot…"
msgstr "Vérification que vous n'êtes pas un robot…"

msgid "Check done: you can create the account."
msgstr "Vérification terminée : vous pouvez créer le compte."

msgid "This check needs JavaScript and a secure connection (HTTPS)."
msgstr "Cette vérification nécessite JavaScript et une connexion sécurisée (HTTPS)."

msgid "This page needs JavaScript to check that you are not a robot."
msgstr "Cette page nécessite JavaScript pour vérifier que vous n'êtes pas un robot."

msgid "Use a passkey"
msgstr "Utiliser une clé d'accès"

msgid "Use a passkey saved on this device or on your phone."
msgstr "Utiliser une clé d'accès enregistrée sur cet appareil ou sur votre téléphone."

msgid "Passkey sign-in did not complete. You can try again or use your password."
msgstr "La connexion par clé d'accès n'a pas abouti. Vous pouvez réessayer ou utiliser votre mot de passe."

